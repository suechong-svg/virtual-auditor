# Copy this file to .env and fill in. Never commit .env to GitHub.

# 1. Model access (console.anthropic.com > API keys). Set a monthly spend limit in the Console.
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-opus-5-5

# Your name, written into the activity log and engagement notes.
# (Production: taken from the Entra ID sign-in instead.)
AUDITOR_NAME=Suzanne

# 2. Autonomy: step_by_step | review_before_filing | autonomous
AUTONOMY=review_before_filing
# Stop a chat session if it costs more than this (USD)
MAX_BUDGET_USD=5

# 3. Folders (optional). Defaults: ./sample_data (read only) and ./audit_workspace (write)
# SOURCES_DIR=C:/Users/you/AuditorDemo/sources
# WORKSPACE_DIR=C:/Users/you/OneDrive/Audit/Engagements

# 4. Phase 2: Confluence and JIRA (free Atlassian Cloud site with FAKE content). Read-only.
# Needs uv installed (https://docs.astral.sh/uv/). Leave blank to switch off.
# CONFLUENCE_URL=https://your-site.atlassian.net/wiki
# JIRA_URL=https://your-site.atlassian.net
# ATLASSIAN_EMAIL=you@example.com
# ATLASSIAN_API_TOKEN=...

# 5. Phase 3: Microsoft Teams (IT creates an Azure Bot registration)
# TEAMS_APP_ID=
# TEAMS_APP_PASSWORD=
# TEAMS_APP_TENANT_ID=
